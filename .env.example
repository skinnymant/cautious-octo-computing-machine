# ─── Core ───────────────────────────────────────────────
NODE_ENV=development
DOMAIN=localhost

# Cổng public của Nginx trên máy host.
# Đổi WEB_PORT nếu cổng 80 đã bị chiếm, ví dụ WEB_PORT=8086
# => web chạy tại http://localhost:8086 (nhớ sửa NEXT_PUBLIC_* bên dưới cho khớp)
WEB_PORT=80
WEB_SSL_PORT=443

# ─── PostgreSQL ─────────────────────────────────────────
POSTGRES_USER=techmart
POSTGRES_PASSWORD=techmart_secret
POSTGRES_DB=techmart
DATABASE_URL=postgresql://techmart:techmart_secret@postgres:5432/techmart?schema=public

# ─── Redis ──────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── Elasticsearch ──────────────────────────────────────
ELASTICSEARCH_NODE=http://elasticsearch:9200

# ─── MinIO (S3) ─────────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_secret
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_BUCKET=techmart-media

# ─── JWT ────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_me_access_secret_in_production
JWT_REFRESH_SECRET=change_me_refresh_secret_in_production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── SMTP (báo giá / quên mật khẩu) ─────────────────────
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TechMart <no-reply@techmart.vn>"

# ─── Payment ────────────────────────────────────────────
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=

# ─── AI ─────────────────────────────────────────────────
ANTHROPIC_API_KEY=
AI_MODEL=claude-fable-5

# ─── Frontend ───────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost/api
NEXT_PUBLIC_SITE_URL=http://localhost
# Used by Next.js server components to reach the API inside the Docker network
INTERNAL_API_URL=http://backend:4000
